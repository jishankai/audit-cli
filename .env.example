# AI Provider Configuration
# Preferred AI provider (anthropic or openai). Default: openai
AI_PROVIDER=openai

# OpenAI API Key (required if AI_PROVIDER=openai or as fallback)
OPENAI_API_KEY=your_openai_api_key_here
# OpenAI model (default: gpt-4.1)
OPENAI_MODEL=gpt-4.1

# Anthropic API Key (required if AI_PROVIDER=anthropic or as fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Anthropic model (default: claude-sonnet-4-20250514)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Note: If AI_PROVIDER is not set, defaults to openai. 
# If preferred provider has no API key, will fallback to available provider.

# Optional: Debug mode
DEBUG=false
